{
  "name": "chrome-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome extension — Another Assistant for Gmail",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "npm run dev:gmail",
    "dev:gmail": "vite build --watch --config packages/site-gmail/vite.config.ts",
    "build": "npm run build:gmail",
    "build:gmail": "vite build --config packages/site-gmail/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "package": "node --import tsx/esm scripts/package.ts"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.1.12",
    "chrome-types": "^0.1.327",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
